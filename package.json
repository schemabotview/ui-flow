{
  "name": "@graphlearning/flow",
  "version": "2.0.0",
  "description": "Declarative scene engine for GraphL — authors describe nodes, edges and nesting; the engine computes every position and paints it.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schemabotview/ui-flow.git"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --emitDeclarationOnly && cp src/styles.css dist/styles.css",
    "watch": "vite build --watch",
    "check": "node scripts/check-geometry.mjs && node scripts/check-visual.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@threeveloper/azure-react-icons": "^1.1.1",
    "aws-react-icons": "^3.3.0",
    "simple-icons": "^16.35.0"
  },
  "peerDependencies": {
    "lucide-react": "^1.28.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.28.0",
    "puppeteer": "^25.12.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
